{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Banking System",
            "type": "shell",
            "command": "mvn -q -DskipTests compile",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Banking System (JavaFX)",
            "type": "shell",
            "command": "mvn javafx:run",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
